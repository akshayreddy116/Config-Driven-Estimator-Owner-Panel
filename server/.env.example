# MongoDB connection string. Local example:
# mongodb://127.0.0.1:27017/roof-estimator
# Atlas example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roof-estimator
MONGODB_URI=mongodb://127.0.0.1:27017/roof-estimator

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# JWT signing secret for owner-panel auth. Change this in production.
JWT_SECRET=change-this-to-a-long-random-string

# Owner login credentials (bootstrap admin — see README for how these are used)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=roofing2026!
